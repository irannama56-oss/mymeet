# ---------------------------------------------------------------------------
# 1. Realtime signaling  (REQUIRED for meetings between different devices)
#    Without these two values the app can only connect tabs in the SAME browser,
#    so every remote guest ends up alone in an apparently "new" room.
#    Create a free project at https://supabase.com -> Settings -> API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# 2. TURN relay  (strongly recommended)
#    STUN alone cannot connect peers behind symmetric NAT / mobile networks.
#    Defaults to the public OpenRelay project if left empty — fine for testing,
#    use your own coturn / Twilio / Metered credentials in production.
# ---------------------------------------------------------------------------
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject
